{
  "name": "chat-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "rm -rf node_modules/.vite && vite",
    "dev:fast": "vite",
    "sync:sdk": "pnpm --dir ../ts-sdks/packages/myso-messaging-stack run build && pnpm install && rm -rf node_modules/.vite && node ./scripts/assert-sdk-message-edited.mjs",
    "build:deps": "pnpm install",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@socialproof/bcs": "^0.0.2",
    "@socialproof/memory": "file:../../myso-memory/packages/sdk",
    "@socialproof/mydata": "^0.0.4",
    "@socialproof/myso": "^0.0.4",
    "@socialproof/myso-groups": "^0.0.1",
    "@socialproof/myso-messaging-stack": "^0.1.3",
    "@socialproof/mysocial-auth": "^0.12.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^1.25.0",
    "orbloom": "^0.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4"
    }
  }
}
