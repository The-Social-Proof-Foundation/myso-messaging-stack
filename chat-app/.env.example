# MySo Network — genesis package IDs (0x2 / 0xe110 / 0x50c1) and shared object IDs
# are resolved automatically via GraphQL. Only network + endpoint URLs are required.
#
# Railway deploy (Root Directory: chat-app): copy these as service variables in the
# Railway dashboard before deploy — Vite inlines VITE_* at build time.
# - Use full VITE_MYSO_GRAPHQL_URL (not /api/graphql; that Vite proxy is dev-only).
# - Set VITE_RELAYER_URL to your deployed relayer public URL.
# - Set VITE_MYSOCIAL_AUTH_REDIRECT_URI to https://<your-app>.up.railway.app/auth/callback
#   and register that URI with MySocial for your client ID.

VITE_MYSO_NETWORK=testnet
VITE_MYSO_RPC_URL=https://fullnode.testnet.mysocial.network:9000
VITE_MYSO_GRAPHQL_URL=https://graphql.testnet.mysocial.network/graphql

# Gas pool (smart gas sponsorship) — used only when VITE_MYSO_NETWORK is testnet/mainnet
# AND the wallet has < 0.001 MySo. Localnet never sponsors even if this URL is set.
# Dev: Vite proxies /api/gas-pool/* → this host. Prod builds call it directly (needs CORS).
# Optional server-only GAS_POOL_TOKEN is injected by the Vite proxy (not exposed to the client).
VITE_MYSO_GAS_POOL_URL=https://gas-pool.testnet.mysocial.network
GAS_POOL_TOKEN=a56b5dff51849ca5233e42cd84cd7de87377b33f292ef9884e52ea737417aa46

# Relayer
VITE_RELAYER_URL=http://localhost:3000

# Social server (optional — paid policy reads, DM block/gate pre-checks in SDK)
# Testnet:
# VITE_SOCIAL_SERVER_URL=https://social.testnet.mysocial.network
# Localnet (`myso start --with-social-indexer`):
# VITE_SOCIAL_SERVER_URL=http://127.0.0.1:9126

# Memory server (Agents workspace: agent chat, recall, remember)
# Dev: Vite proxies /api/memory/* → this host (CORS-safe). Prod builds call it directly,
# so the memory server's ALLOWED_ORIGINS must include this app's origin.
#
# Agent replies are generated through the AI-credit gateway, never by a provider key in the
# browser: with AI_CREDIT_ENABLED=true on the memory server, /api/ask reserves a credit and
# calls AI_CREDIT_ORACLE_URL, which proxies OpenRouter. Nothing about the gateway belongs in
# this file — the oracle URL and its API secret stay server-side.
#
# Memory is used on demand: the browser decides per turn whether a question needs stored
# facts, and sends recall:false when it does not, which skips the embedding, the vector
# search and every MYDATA decrypt. There is no client switch for that; see
# src/lib/agents/memory-turn.ts.
#
# Headless agents (a service, worker, or automations-server job) use the same three fields
# the browser resolves from the custody vault — key, account id, server URL — through
# createHeadlessAgentMemoryClient(). Those are runtime values, not Vite inlines, so they are
# deliberately not defined here.
VITE_MEMORY_SERVER_URL=http://127.0.0.1:8000

# Automation (Agents → Overview → Automation panel)
#
# Scheduled and event-triggered work runs in the myso-memory automations engine, not here.
# This app reaches it only through the memory server, which needs AUTOMATION_ENGINE_URL set;
# there is deliberately no variable for the engine's shared secret, because the browser must
# never hold it. Requests are Ed25519-signed by the agent key and proxied by
# the memory server, which stamps ownership from that signature — see
# src/lib/agents/automation-client.ts.
#
# Consequences worth knowing:
#   - the Automation panel shows "engine not reachable" until AUTOMATION_ENGINE_URL is set
#     on the memory server, and shows no jobs even if the engine itself is healthy
#   - jobs a scheduled run writes land in the `chat-app` memory namespace (the engine's
#     memory_scope), which is the same namespace this app recalls from
#   - signing needs WebCrypto Ed25519 (Chrome 113+, Safari 17+, Firefox 130+)
#
# Automation delegates (unattended jobs)
#
# A job never runs with the user's own agent keys. The owner registers a short-lived,
# memory-only, spend-capped *delegate* on-chain and this app encrypts its seed to the memory
# bridge in the browser. VITE_AUTOMATION_MYDATA_KEY is the bridge's PUBLIC MyData key (safe to
# ship; it can only encrypt, never open). Generate the pair with `pnpm gen:mydata-key` in
# myso-memory: the private line goes to the bridge's Railway secret, this line goes here.
# Without it the "Create delegate" action stays disabled.
# VITE_AUTOMATION_MYDATA_KEY=k202610:<base64url public key>

# --- Localnet example (uncomment and adjust after `myso start --with-faucet --with-mydata --with-graphql --with-social-indexer`) ---
# VITE_MYSO_NETWORK=localnet
# VITE_MYSO_GRAPHQL_URL=http://127.0.0.1:9125/graphql
# VITE_SOCIAL_SERVER_URL=http://127.0.0.1:9126
# JSON-RPC (local fullnode; Vite dev proxies via /api/rpc to avoid CORS):
# VITE_MYSO_RPC_URL=http://127.0.0.1:9001

# Postgres (relayer production): STORAGE_TYPE=postgres DATABASE_URL=postgres://...

# File Storage (testnet defaults)
VITE_FILE_STORAGE_PUBLISHER_URL=https://publisher.file-storage-testnet.mysocial.network
VITE_FILE_STORAGE_AGGREGATOR_URL=https://aggregator.file-storage-testnet.mysocial.network
VITE_FILE_STORAGE_EPOCHS=5

# Optional: portable history recovery via relayer R2 archive (opt-in)
# Requires relayer ARCHIVE_BACKEND=r2 with matching ARCHIVE_NAMESPACE.
# Uses VITE_RELAYER_URL — no separate archive service.
# VITE_ENABLE_MESSAGE_RECOVERY=true
# VITE_ARCHIVE_NAMESPACE=mysocial

# MyData Key Servers (threshold encryption)
# Testnet: use two or more object IDs; threshold defaults to 2.
# VITE_MYDATA_KEY_SERVER_OBJECT_IDS=0x...,0x...
# Localnet: copy parent KEY_SERVER_OBJECT_ID from `myso start --with-mydata` (http://127.0.0.1:2024).
# Must be key_server::KeyServer — verify: `myso client object <id>` (NOT dynamic_field::Field<…KeyServerV1>).
# After --force-regenesis: update this value, restart `pnpm dev`, and re-faucet your dev signer.
# Local key-server accepts @socialproof/mydata SDK >=0.0.4 (ts_sdk_version_requirement in generated yaml).
# VITE_MYDATA_KEY_SERVER_OBJECT_IDS=0x...
# VITE_MYDATA_THRESHOLD=1

# MySocial Auth — register redirect URI with MySocial per client ID.
# apiBaseUrl = salt service origin (SDK calls /auth/refresh and /auth/logout here).
# Do NOT set apiBaseUrl to auth.testnet — that host has no CORS for localhost,
# so /auth/refresh fails and you get logged out when the access JWT expires (~30m).
# SALT_URL = full /salt path for keypair derivation POST (separate from apiBaseUrl).
VITE_MYSOCIAL_AUTH_API_BASE_URL=https://salt.testnet.mysocial.network
VITE_MYSOCIAL_AUTH_ORIGIN=https://auth.testnet.mysocial.network
VITE_MYSOCIAL_AUTH_CLIENT_ID=your-platform-client-id
VITE_MYSOCIAL_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_MYSOCIAL_SALT_URL=https://salt.testnet.mysocial.network/salt
# Same zkLogin prover the MySocial web app uses (POST /prove).
VITE_ZKLOGIN_PROVER_URL=https://prover.testnet.mysocial.network/prove

# Public MySocial web app (profile deep links from chat nav → /wallet?address=…)
# VITE_MYSOCIAL_WEB_ORIGIN=https://www.mysocial.network

# Local dev only — keep false when testing real MySocial OAuth wallet identity
VITE_DEV_UNBLOCK_MESSAGING_UI=false

# Optional: shared Platform object ID for paid-DM escrow claims.
# When set, platform fees route to Platform.treasury on-chain.
# When unset, fees route to the ecosystem treasury (0x0 sentinel).
# VITE_PLATFORM_ID=0x...

# Requires Memory 0.0.6+ and enabled/configured server custody tiers. The MySocial login always
# holds an account's agent keys and needs no client configuration; a passkey is an optional backup.
# The client offers only the tiers GET /config advertises, so the server list is authoritative.
VITE_AGENT_KEY_BACKUPS_ENABLED=false
# Additional exact MYDATA key-server / websocket origins for the production vault CSP.
# VITE_PASSKEY_CONNECT_ORIGINS=https://keys.example.com,wss://relayer.example.com

# Optional: transaction details link for chat payment cards ({digest} is replaced).
# VITE_EXPLORER_TX_URL=https://<explorer-host>/explore/transactions/{digest}
